@page "/tasks/{TaskId:int}/edit"
@attribute [Authorize]
@inject ITaskService TaskService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="mb-8 flex items-center justify-between px-4 pt-8">
        <h3 class="text-3xl font-extrabold text-slate-900">Edit Task</h3>
</div>

@if (isLoading)
{
    <div class="mx-auto max-w-md rounded-xl bg-white px-6 py-8 text-center shadow-md">
        <p class="text-gray-600">Loading task...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="mx-auto max-w-md rounded-xl bg-red-100 px-6 py-8 text-center text-red-800 shadow-md">@errorMessage</div>
}
else
{
    <div class="mx-auto w-full max-w-md rounded-2xl bg-white px-6 py-8 shadow-lg ring-1 ring-slate-900/5">
        <EditForm Model="@editModel" OnValidSubmit="SaveChanges" class="space-y-6">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="space-y-2">
                <label class="ml-1 block text-sm font-bold text-gray-700">Title</label>
                <InputText @bind-Value="editModel.Title" class="block w-full rounded-xl border-0 bg-gray-50 px-3 py-3 text-gray-900 shadow-md ring-1 ring-gray-200 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-[#1A3B2B] focus:ring-inset sm:text-sm sm:leading-6" />
            </div>

            <div class="space-y-2">
                <label class="ml-1 block text-sm font-bold text-gray-700">Description</label>
                <InputTextArea @bind-Value="editModel.Description" rows="3" class="block w-full rounded-xl border-0 bg-gray-50 px-3 py-3 text-gray-900 shadow-md ring-1 ring-gray-200 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-[#1A3B2B] focus:ring-inset sm:text-sm sm:leading-6" />
            </div>

            <label class="flex cursor-pointer items-center justify-between rounded-xl bg-white p-1 shadow-md shadow-md">
                <div class="flex flex-col pl-1">
                    <span class="font-bold text-gray-900">Schedule Task</span>
                    <span class="text-xs text-gray-500">Set a due date and time</span>
                </div>
                <div class="relative inline-flex items-center pr-1">
                    <InputCheckbox @bind-Value="IsSchedulable" class="peer sr-only" />
                    <div class="peer h-7 w-12 rounded-full bg-gray-200 after:absolute after:top-[4px] after:left-[4px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow-sm after:transition-all after:content-[''] peer-checked:bg-[#174928] peer-checked:after:translate-x-5 peer-focus:outline-none"></div>
                </div>
            </label>

            @if (editModel.IsSchedulable)
            {
                <div class="animate-in slide-in-from-top-2 fade-in space-y-3 duration-200">
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <div class="space-y-2">
                            <label class="ml-1 block text-sm font-bold text-gray-700">Date</label>
                            <InputDate @bind-Value="ScheduleDate" class="block w-full rounded-xl border-0 bg-gray-50 px-3 py-3 text-gray-900 shadow-md ring-1 ring-gray-200 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-[#1A3B2B] focus:ring-inset sm:text-sm sm:leading-6" />
                        </div>
                        <div class="space-y-2">
                            <label class="ml-1 block text-sm font-bold text-gray-700">Time</label>
                            <InputText type="time" @bind-Value="ScheduleTimeText" class="block w-full rounded-xl border-0 bg-gray-50 px-3 py-3 text-gray-900 shadow-md ring-1 ring-gray-200 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-[#1A3B2B] focus:ring-inset sm:text-sm sm:leading-6" />
                        </div>
                    </div>

                    <p class="text-xs text-gray-500">We use your device's local time when scheduling.</p>

                    @if (!string.IsNullOrEmpty(scheduleError))
                    {
                        <p class="text-sm font-semibold text-red-600">@scheduleError</p>
                    }
                </div>
            }

            <label class="flex cursor-pointer items-center justify-between rounded-xl bg-white p-1 shadow-md">
                <div class="flex flex-col pl-1">
                    <span class="font-bold text-gray-900">Repeat Task</span>
                    @if (editModel.IsRepeatable)
                    {
                        <span class="text-xs text-gray-500">Repeats every @editModel.RepeatInterval @editModel.Frequency</span>
                    }
                    else
                    {
                        <span class="text-xs text-gray-500">Enable to make task repeatable</span>
                    }
                </div>
                <div class="relative inline-flex items-center pr-1">
                    <InputCheckbox @bind-Value="IsRepeatable" class="peer sr-only" />
                    <div class="peer h-7 w-12 rounded-full bg-gray-200 after:absolute after:top-[4px] after:left-[4px] after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow-sm after:transition-all after:content-[''] peer-checked:bg-[#174928] peer-checked:after:translate-x-5 peer-focus:outline-none"></div>
                </div>
            </label>

            @if (editModel.IsRepeatable)
            {
                <div class="animate-in slide-in-from-top-2 fade-in space-y-4 rounded-xl bg-gray-50 p-4 shadow-md duration-200">
                    <div class="grid grid-cols-4 gap-2">
                        @foreach (var freq in Enum.GetValues<TaskItem.RepeatFrequency>())
                        {
                            <button type="button" @onclick="() => editModel.Frequency = freq" class="@GetFrequencyClass(freq)">
                                @freq
                            </button>
                        }
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <span class="text-sm font-bold text-gray-700 w-24">Repeat every</span>
                            <InputNumber @bind-Value="editModel.RepeatInterval" min="1" max="99" class="block w-20 rounded-xl border-0 bg-white px-3 py-2 text-center text-gray-900 shadow-md ring-1 ring-gray-200 ring-inset focus:ring-2 focus:ring-[#1A3B2B] focus:ring-inset sm:text-sm sm:leading-6" />
                            <span class="text-sm font-bold text-gray-700">
                                @(GetFrequencyUnit(editModel.Frequency))@((editModel.RepeatInterval ?? 1) > 1 ? "s" : string.Empty)
                            </span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-sm font-bold text-gray-700 w-24">Ensure</span>
                            <InputNumber @bind-Value="editModel.RecurringCount" min="1" max="100" class="block w-20 rounded-xl border-0 bg-white px-3 py-2 text-center text-gray-900 shadow-md ring-1 ring-gray-200 ring-inset focus:ring-2 focus:ring-[#1A3B2B] focus:ring-inset sm:text-sm sm:leading-6" />
                            <span class="text-sm font-bold text-gray-700">
                                occurrences
                            </span>
                        </div>
                        <p class="text-xs text-gray-500 italic">
                             Adjusting this will ensure at least @editModel.RecurringCount future occurrences exist.
                        </p>
                    </div>
                </div>
            }

            <div class="space-y-2">
                <label class="ml-1 block text-sm font-bold text-gray-700">Priority</label>
                <div class="flex gap-3">
                    @foreach (var priority in Enum.GetValues<TaskItem.Priority>())
                    {
                        <button type="button" @onclick="() => editModel.TaskPriority = priority"
                                class="@GetPriorityClass(priority) shadow-md flex-1 rounded-xl border py-3 text-sm font-bold transition-all duration-200">
                            @priority
                        </button>
                    }
                </div>
            </div>

            <div class="flex gap-3 pt-4">
                <button type="submit" disabled="@isSaving" class="flex-1 rounded-xl bg-[#174928] py-4 text-center text-lg font-bold text-white shadow-lg shadow-[#1A3B2B]/20 hover:scale-[1.02]">
                    @(isSaving ? "Saving..." : "Save Changes")
                </button>
                <button type="button" class="flex-1 rounded-xl border-2 border-[#174928] py-4 text-lg font-bold text-[#174928]" @onclick='() => Navigation.NavigateTo("/")'>Cancel</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int TaskId { get; set; }

    private TaskInputModel editModel = new();
    private DateOnly? scheduleDate;
    private TimeSpan? scheduleTime;
    private string? scheduleError;

    private bool IsSchedulable
    {
        get => editModel.IsSchedulable;
        set
        {
            editModel.IsSchedulable = value;
            if (!value)
            {
                editModel.IsRepeatable = false;
                scheduleError = null;
                editModel.Schedule = null;
            }
            else
            {
                if (scheduleDate is null || scheduleTime is null)
                {
                    var now = DateTime.Now;
                    scheduleDate = DateOnly.FromDateTime(now);
                    scheduleTime = TrimToMinute(now.TimeOfDay);
                }

                UpdateScheduleFromParts();
            }
        }
    }

    private bool IsRepeatable
    {
        get => editModel.IsRepeatable;
        set
        {
            editModel.IsRepeatable = value;
            if (value)
            {
                editModel.IsSchedulable = true;
                if (scheduleDate is null || scheduleTime is null)
                {
                    var now = DateTime.Now;
                    scheduleDate = DateOnly.FromDateTime(now);
                    scheduleTime = TrimToMinute(now.TimeOfDay);
                    UpdateScheduleFromParts();
                }
            }
        }
    }

    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string? userId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTaskAsync();
    }

    private async Task LoadTaskAsync()
    {
        isLoading = true;
        errorMessage = null;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.GetUserId();

        if (string.IsNullOrEmpty(userId))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var entity = await TaskService.GetByIdAsync(TaskId, userId);
        if (entity is null)
        {
            errorMessage = "Task not found or you do not have access.";
        }
        else
        {
            editModel = TaskInputModel.FromEntity(entity);
            SyncScheduleFieldsFromModel();
        }

        isLoading = false;
    }

    private async Task SaveChanges()
    {
        if (string.IsNullOrEmpty(userId))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (editModel.IsSchedulable)
        {
            if (scheduleDate is null || scheduleTime is null)
            {
                scheduleError = "Pick both a date and time.";
                return;
            }

            scheduleError = null;
            editModel.Schedule = ComposeSchedule(scheduleDate, scheduleTime);
        }
        else
        {
            scheduleError = null;
            editModel.Schedule = null;
        }

        try
        {
            isSaving = true;
            var updated = await TaskService.UpdateAsync(TaskId, editModel, userId);
            if (!updated)
            {
                errorMessage = "Unable to update task. It may have been deleted.";
                return;
            }

            Navigation.NavigateTo("/");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetFrequencyClass(TaskItem.RepeatFrequency frequency)
    {
        var isSelected = editModel.Frequency == frequency;
        var baseClasses = "flex items-center justify-center rounded-xl py-2 text-xs font-bold transition-all";
        var stateClasses = isSelected
            ? "bg-[#174928] text-white shadow-inner"
            : "bg-white text-gray-600 shadow-md hover:bg-gray-100";
        return $"{stateClasses} {baseClasses}";
    }

    private string GetPriorityClass(TaskItem.Priority priority)
    {
        bool isSelected = editModel.TaskPriority == priority;
        return isSelected
            ? priority switch
            {
                TaskItem.Priority.High => "bg-red-50 border-red-200 text-red-700 ring-2 ring-red-500 ",
                TaskItem.Priority.Medium => "bg-yellow-50 border-yellow-200 text-yellow-700 ring-2 ring-yellow-500",
                TaskItem.Priority.Low => "bg-green-50 border-green-200 text-green-700 ring-2 ring-green-500",
                _ => "bg-gray-100 border-gray-200 text-gray-900"
            }
            : "bg-white border-gray-200 text-gray-400 hover:bg-gray-50 hover:text-gray-600 hover:border-gray-300";
    }

    private string GetFrequencyUnit(TaskItem.RepeatFrequency frequency)
    {
        return frequency switch
        {
            TaskItem.RepeatFrequency.Daily => "Day",
            TaskItem.RepeatFrequency.Weekly => "Week",
            TaskItem.RepeatFrequency.Monthly => "Month",
            TaskItem.RepeatFrequency.Yearly => "Year",
            _ => frequency.ToString()
        };
    }

    private DateOnly? ScheduleDate
    {
        get => scheduleDate;
        set
        {
            scheduleDate = value;
            UpdateScheduleFromParts();
        }
    }

    private string ScheduleTimeText
    {
        get => scheduleTime.HasValue ? TimeOnly.FromTimeSpan(scheduleTime.Value).ToString("HH:mm") : string.Empty;
        set
        {
            if (TimeSpan.TryParse(value, out var parsed))
            {
                scheduleTime = TrimToMinute(parsed);
                scheduleError = null;
            }
            else
            {
                scheduleTime = null;
            }

            UpdateScheduleFromParts();
        }
    }

    private void SyncScheduleFieldsFromModel()
    {
        if (editModel.Schedule.HasValue)
        {
            var value = editModel.Schedule.Value;
            scheduleDate = DateOnly.FromDateTime(value);
            scheduleTime = TrimToMinute(value.TimeOfDay);
        }
        else
        {
            var now = DateTime.Now;
            scheduleDate = DateOnly.FromDateTime(now);
            scheduleTime = TrimToMinute(now.TimeOfDay);
        }

        if (editModel.IsSchedulable)
        {
            UpdateScheduleFromParts();
        }
    }

    private void UpdateScheduleFromParts()
    {
        editModel.Schedule = ComposeSchedule(scheduleDate, scheduleTime);
    }

    private static DateTime? ComposeSchedule(DateOnly? date, TimeSpan? time)
    {
        if (date is null || time is null)
        {
            return null;
        }

        var local = date.Value.ToDateTime(TimeOnly.FromTimeSpan(time.Value));
        return DateTime.SpecifyKind(local, DateTimeKind.Unspecified);
    }

    private static TimeSpan TrimToMinute(TimeSpan time) => new(time.Hours, time.Minutes, 0);
}
